{
  "info": {
    "name": "AISkinCareBackend API",
    "description": "Production-ready Postman Collection for Gen-Z Skincare Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "routineId",
      "value": "",
      "type": "string"
    },
    {
      "key": "stepId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health"
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kaven Patel\",\n  \"email\": \"kaven@example.com\",\n  \"password\": \"Password123!\",\n  \"gender\": \"male\",\n  \"age\": 22\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register" }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kaven@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh" }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kaven@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password" }
          }
        }
      ]
    },
    {
      "name": "2. User Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/profile" }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kaven Patel\",\n  \"age\": 23\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/profile" }
          }
        }
      ]
    },
    {
      "name": "3. Skin Profile",
      "item": [
        {
          "name": "Get Skin Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/skin-profile" }
          }
        },
        {
          "name": "Create Skin Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skinType\": \"combination\",\n  \"concerns\": [\"acne\", \"large-pores\", \"dark-spots\"],\n  \"lifestyle\": {\n    \"waterIntakeLiters\": 3,\n    \"sleepHours\": 8,\n    \"sunscreenUsage\": \"always\",\n    \"smokingStatus\": \"non-smoker\",\n    \"stressLevel\": \"low\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/skin-profile" }
          }
        },
        {
          "name": "Update Skin Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skinType\": \"oily\",\n  \"concerns\": [\"acne\", \"pimples\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/skin-profile" }
          }
        }
      ]
    },
    {
      "name": "4. Routines",
      "item": [
        {
          "name": "Get All Routines",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/routines" }
          }
        },
        {
          "name": "Create Morning Routine",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('routineId', jsonData.data._id);",
                  "    if (jsonData.data.steps && jsonData.data.steps.length > 0) {",
                  "        pm.collectionVariables.set('stepId', jsonData.data.steps[0]._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Morning Glow Routine\",\n  \"type\": \"morning\",\n  \"description\": \"Everyday AM brightening and protection routine\",\n  \"steps\": [\n    { \"title\": \"Face Wash\", \"category\": \"face-wash\", \"order\": 1 },\n    { \"title\": \"Vitamin C Serum\", \"category\": \"serum\", \"order\": 2 },\n    { \"title\": \"Moisturizer\", \"category\": \"moisturizer\", \"order\": 3 },\n    { \"title\": \"Sunscreen SPF 50+\", \"category\": \"sunscreen\", \"order\": 4 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/routines" }
          }
        },
        {
          "name": "Today Routines Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/routines/today" }
          }
        },
        {
          "name": "Toggle Complete Step",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stepId\": \"{{stepId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/routines/{{routineId}}/complete" }
          }
        },
        {
          "name": "Routine Statistics & Streaks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/routines/stats" }
          }
        }
      ]
    },
    {
      "name": "5. Products",
      "item": [
        {
          "name": "Get Products (Paginated)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products?page=1&limit=10" }
          }
        },
        {
          "name": "Filter by Skin Type & Concern",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products?skinType=oily&concern=acne" }
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/search?q=CeraVe" }
          }
        },
        {
          "name": "Filter by Category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/category/sunscreen" }
          }
        }
      ]
    },
    {
      "name": "6. Mobile Dashboard",
      "item": [
        {
          "name": "Get Aggregated Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard" }
          }
        }
      ]
    }
  ]
}
