# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/aiskincare

# JWT Secrets (Generate strong random 64-char strings for production)
JWT_ACCESS_SECRET=gen_z_skincare_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=gen_z_skincare_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# AI Rate Limiting & Optimization
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=10
AI_ANALYSIS_VERSION=1.0
AI_PROMPT_VERSION=1.0
AI_CACHE_DUPLICATES=true
